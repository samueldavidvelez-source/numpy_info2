import numpy as np
import matplotlib.pyplot as plt

x = np.linspace(0, 2*np.pi, 100)
y_sin = np.sin(x)

plt.plot(x, y_sin, linestyle='--', color='red')
plt.title("Seno")
plt.xlabel("x (radianes)")
plt.ylabel("valor")

plt.show()

#----------------------------------------------------------------------
x=np.linspace(0, 2*np.pi, 100)
y_cos=np.cos(x)

plt.plot(x, y_cos, linestyle='-', color='blue')
plt.title("Coseno") 
plt.xlabel("x (radianes)")
plt.ylabel("valor")

plt.show()

#----------------------------------------------------------------------
x = np.linspace(0, 2*np.pi, 100)
y_sin = np.sin(x)
y_cos = np.cos(x)

plt.plot(x, y_sin, label='sin(x)')
plt.plot(x, y_cos, label='cos(x)')
plt.title("Seno y coseno")
plt.xlabel("x (radianes)")
plt.ylabel("valor")
plt.legend()
plt.show()


#----------------------------------------------------------------------

datos = 20 + 3 * np.random.randn(1000)

plt.hist(datos, bins=50, density=True, color='pink')

x = np.linspace(min(datos), max(datos), 100)
curva = (1 / (3 * np.sqrt(2*np.pi))) * np.exp(-0.5 * ((x - 20) / 3) ** 2)
plt.plot(x, curva, linestyle='--', color='magenta')

plt.title("Histograma")
plt.xlabel("Valor x")
plt.ylabel("Probabilidad")
plt.show()

#----------------------------------------------------------------------
x = np.linspace(-10, 10, 100)

plt.plot(x, 2*x + 1, label='2x + 1')
plt.plot(x, -x**2, label='-x^2')

plt.title("Funciones en el mismo plano")
plt.xlabel("x")
plt.ylabel("y")
plt.legend()
plt.show()


